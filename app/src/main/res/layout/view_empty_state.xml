<?xml version="1.0" encoding="utf-8"?>
<!-- Trạng thái rỗng dùng chung: icon + tiêu đề + 1 dòng giải thích. Nội dung gán trong Fragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_32">

    <ImageView
        android:id="@+id/iv_empty_icon"
        android:layout_width="@dimen/icon_xl"
        android:layout_height="@dimen/icon_xl"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_event_note_24"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="Chưa có kèo quanh bạn" />

    <TextView
        android:id="@+id/tv_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Thử tăng bán kính hoặc tự tạo một kèo" />
</LinearLayout>
