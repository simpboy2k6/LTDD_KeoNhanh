<?xml version="1.0" encoding="utf-8"?>
<!--
  S06 Mã mời vào kèo (TV1). Mở từ icon QR trên thanh tiêu đề S15 khi kèo đang mở.
  QR cố định theo kèo (không đổi 30 giây như bản check-in cũ). Tuần 4: sinh QR bằng ZXing từ link mời.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.checkin.InviteQrFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/invite_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <!-- Kèo đang mời -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:id="@+id/iv_sport"
                        style="@style/Widget.KeoNhanh.SportTile"
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:padding="@dimen/space_12"
                        android:src="@drawable/ic_chess_pawn_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            tools:text="Ma Sói tối nay" />

                        <TextView
                            android:id="@+id/tv_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="6/8 người · 19:30 hôm nay" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- QR + mã mời dạng chữ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_24">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/invite_instruction"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/iv_qr"
                        android:layout_width="@dimen/qr_size"
                        android:layout_height="@dimen/qr_size"
                        android:layout_marginTop="@dimen/space_16"
                        android:src="@drawable/img_qr_sample"
                        tools:contentDescription="@string/cd_invite_qr" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/invite_code_label"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Mã gõ tay khi không quét được (đọc qua điện thoại, nhắn tin...) -->
                        <TextView
                            android:id="@+id/tv_invite_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.15"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textIsSelectable="true"
                            tools:text="MS8X4P" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy"
                            style="@style/Widget.KeoNhanh.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/invite_copy"
                            app:icon="@drawable/ic_content_copy_24"
                            app:iconTint="@color/kn_green_text" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chỉ hiện khi kèo có ngưỡng uy tín -->
            <TextView
                android:id="@+id/tv_trust_note"
                style="@style/Widget.KeoNhanh.Badge.Green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:drawableStart="@drawable/ic_verified_user_16"
                android:maxLines="2"
                tools:text="Kèo có ngưỡng uy tín ≥ 70%: người vào bằng mã vẫn phải xin vào" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        android:text="@string/invite_share"
        app:icon="@drawable/ic_share_24" />
</LinearLayout>
