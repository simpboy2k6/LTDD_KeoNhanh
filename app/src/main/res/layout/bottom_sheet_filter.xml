<?xml version="1.0" encoding="utf-8"?>
<!-- S11 Bộ lọc (TV2): bottom sheet mở từ chip bán kính ở S09 / S10 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_24"
    android:paddingBottom="@dimen/space_24"
    tools:context=".ui.explore.FilterBottomSheet">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filter_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/filter_sport"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <!-- Chọn nhiều môn; không chọn môn nào = tất cả -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_sport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_soccer"
            style="@style/Widget.KeoNhanh.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_soccer"
            app:chipIcon="@drawable/ic_sports_soccer_24"
            app:chipIconVisible="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_badminton"
            style="@style/Widget.KeoNhanh.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_badminton"
            app:chipIcon="@drawable/ic_badminton_24"
            app:chipIconVisible="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_board_game"
            style="@style/Widget.KeoNhanh.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_board_game"
            app:chipIcon="@drawable/ic_chess_pawn_24"
            app:chipIconVisible="true" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_radius"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/tv_radius_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/kn_green_text"
            tools:text="3 km" />
    </LinearLayout>

    <!-- Bán kính 1–5 km theo phạm vi đề tài -->
    <com.google.android.material.slider.Slider
        android:id="@+id/slider_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/filter_radius"
        android:stepSize="1"
        android:value="3"
        android:valueFrom="1"
        android:valueTo="5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_12"
            android:layout_weight="1"
            android:text="@string/filter_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_apply" />
    </LinearLayout>
</LinearLayout>
