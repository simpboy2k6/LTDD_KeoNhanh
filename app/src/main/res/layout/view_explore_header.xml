<?xml version="1.0" encoding="utf-8"?>
<!-- Phần đầu dùng chung cho S09 và S10 (TV2): thanh tìm kiếm, chip môn, nút đổi Bản đồ / Danh sách -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_8">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_bar_height"
        android:layout_marginHorizontal="@dimen/space_16"
        app:cardCornerRadius="@dimen/radius_pill"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="@dimen/stroke_thin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_8">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search_24"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_search_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/explore_search_hint"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Bấm để mở S07 Quét mã mời (kèo được mời có thể nằm ngoài bán kính đang lọc) -->
            <ImageButton
                android:id="@+id/btn_scan_invite"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_scan_invite"
                android:src="@drawable/ic_qr_code_scanner_24"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Bấm để mở S11 Bộ lọc -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_radius"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_open_filter"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:chipBackgroundColor="@color/kn_green_tint"
                app:chipIcon="@drawable/ic_tune_24"
                app:chipIconTint="@color/kn_green_text"
                app:chipStrokeWidth="0dp"
                tools:text="3 km" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_16"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_sport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chip_all"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.KeoNhanh.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_soccer"
                style="@style/Widget.KeoNhanh.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_soccer"
                app:chipIcon="@drawable/ic_sports_soccer_24"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_badminton"
                style="@style/Widget.KeoNhanh.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_badminton"
                app:chipIcon="@drawable/ic_badminton_24"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_board_game"
                style="@style/Widget.KeoNhanh.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_board_game"
                app:chipIcon="@drawable/ic_chess_pawn_24"
                app:chipIconVisible="true" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Chữ và icon gán trong Fragment: S09 hiện "Danh sách", S10 hiện "Bản đồ" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_view"
        style="@style/Widget.KeoNhanh.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_16"
        app:icon="@drawable/ic_format_list_bulleted_24"
        tools:text="Danh sách" />
</LinearLayout>
