<?xml version="1.0" encoding="utf-8"?>
<!-- S15 Chi tiết kèo / phòng chờ (TV3): màn trung tâm của mọi luồng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.lobby.LobbyFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/menu_lobby"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/lobby_title" />

    <!-- Tuần 3: thanh tải trong lúc chờ Firestore trả dữ liệu lần đầu -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/kn_green" />

    <!-- Tuần 3: kèo không mở được (đã bị hủy, mất mạng, không có quyền) -->
    <include
        android:id="@+id/error_state"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <!-- Thẻ 1: thông tin kèo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_sport"
                            style="@style/Widget.KeoNhanh.SportTile"
                            android:layout_width="@dimen/sport_tile"
                            android:layout_height="@dimen/sport_tile"
                            android:backgroundTint="@color/kn_purple"
                            android:src="@drawable/ic_chess_pawn_24" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                tools:text="Ma Sói tối nay" />

                            <TextView
                                android:id="@+id/tv_sport_tag"
                                style="@style/Widget.KeoNhanh.Badge.Purple"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                tools:text="Board game" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.KeoNhanh.RowIcon"
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:src="@drawable/ic_location_on_24" />

                        <TextView
                            android:id="@+id/tv_place"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Quán board game gần trường · 0,6 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.KeoNhanh.RowIcon"
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:src="@drawable/ic_schedule_24" />

                        <TextView
                            android:id="@+id/tv_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="19:30 hôm nay · Chủ kèo: Minh (uy tín 92%)" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thẻ check-in theo khoảng cách (TV1): chỉ hiện khi kèo ở trạng thái Check-in -->
            <include
                android:id="@+id/checkin"
                layout="@layout/view_checkin_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Thẻ 2: đếm ngược tới hạn chốt (ẩn khi đã sang Check-in) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/kn_green_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lobby_countdown_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/kn_on_dark_muted" />

                    <TextView
                        android:id="@+id/tv_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.KeoNhanh.Countdown"
                        android:textColor="@color/kn_orange_light"
                        tools:text="00:45:12" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_deadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:max="100"
                        app:indicatorColor="@color/kn_orange_light"
                        app:trackColor="@color/kn_on_dark_track"
                        app:trackCornerRadius="@dimen/space_4"
                        app:trackThickness="@dimen/progress_height"
                        tools:progress="55" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thẻ 3: thành viên (lưới 4 cột, ô trống có dấu +) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lobby_members"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/tv_members_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/kn_green_text"
                            tools:text="6/8" />

                        <TextView
                            android:id="@+id/tv_min_trust"
                            style="@style/Widget.KeoNhanh.Badge.Green"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_verified_user_16"
                            tools:text="Yêu cầu uy tín ≥ 70%" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_members"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="4"
                        tools:itemCount="8"
                        tools:listitem="@layout/item_member" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thẻ 4: xem trước chat, bấm để mở S16 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_chat_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.KeoNhanh.RowIcon"
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:src="@drawable/ic_chat_bubble_24" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:text="@string/lobby_chat_preview"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_preview_avatar"
                            style="@style/Widget.KeoNhanh.Avatar.Small"
                            android:layout_width="@dimen/avatar_sm"
                            android:layout_height="@dimen/avatar_sm"
                            tools:text="A" />

                        <TextView
                            android:id="@+id/tv_preview_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:background="@drawable/bg_bubble_preview"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:paddingHorizontal="@dimen/space_16"
                            android:paddingVertical="@dimen/space_8"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Mình mang bộ bài, 19:20 có mặt nhé!" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút chính đổi theo trạng thái kèo và vai trò (bảng ở mục 3 tài liệu tuần 2) -->
    <LinearLayout
        android:id="@+id/bar_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Tham gia kèo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chat"
            style="@style/Widget.KeoNhanh.Button.OutlinedIcon"
            android:layout_width="@dimen/button_height"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:contentDescription="@string/cd_open_chat"
            app:icon="@drawable/ic_chat_bubble_24" />
    </LinearLayout>
</LinearLayout>
