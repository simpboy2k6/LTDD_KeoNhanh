<?xml version="1.0" encoding="utf-8"?>
<!-- Tin nhắn của người khác ở S16: avatar + tên + bong bóng trắng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_4"
    android:paddingEnd="@dimen/space_48">

    <TextView
        android:id="@+id/tv_avatar"
        style="@style/Widget.KeoNhanh.Avatar.Small"
        android:layout_width="@dimen/avatar_sm"
        android:layout_height="@dimen/avatar_sm"
        tools:text="A" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="An · 19:02" />

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_bubble_other"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Mình mang bộ bài, 19:20 có mặt nhé!" />
    </LinearLayout>
</LinearLayout>
